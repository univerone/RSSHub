NODE_ENV=production
PORT=1200
LISTEN_INADDR_ANY=0
ENABLE_CLUSTER=false

CACHE_TYPE=memory
CACHE_EXPIRE=300
CACHE_CONTENT_EXPIRE=3600
MEMORY_MAX=256

DEBUG_INFO=false
DISALLOW_ROBOT=true
NO_LOGFILES=1

# Runtime secrets. Leave blank unless the route needs them.
ACCESS_KEY=
GITHUB_ACCESS_TOKEN=
TWITTER_AUTH_TOKEN=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
YOUTUBE_KEY=
ZHIHU_COOKIES=
